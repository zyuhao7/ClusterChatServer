{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "ClusterChat Desktop",
    "version": "0.1.0",
    "identifier": "com.clusterchat.desktop",
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build",
        "devUrl": "http://localhost:1420",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "ClusterChat Desktop",
                "width": 1440,
                "height": 960,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": []
    }
}
