        "@types/react-dom": "^18.3.1",
        "@vitejs/plugin-react": "^4.3.3",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "prettier": "^3.9.10",
